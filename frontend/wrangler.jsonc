{
  // Static-assets-only Worker: serves the Vite build and falls back to index.html for client routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainee-sc",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
